# TriageAI - Full edition (for running locally; uses more than 512 MB of RAM).
# Same app as the Lite edition, but embeddings run on sentence-transformers + torch (CPU).
#   docker build -f Dockerfile.full -t triage-ai-full .
#   docker run -p 7860:7860 -e ANTHROPIC_API_KEY=... triage-ai-full

# ---- Stage 1: build the React + Vite + Tailwind frontend ----------------------------------
FROM node:20-alpine AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

# ---- Stage 2: Python backend ----------------------------------------------------------------
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/.cache/huggingface \
    HF_HUB_DISABLE_TELEMETRY=1 \
    PORT=7860

# Hugging Face Spaces runs containers as uid 1000.
RUN useradd -m -u 1000 user
WORKDIR /app

# CPU-only torch first (avoids the multi-GB CUDA build), then the Full requirements.
COPY requirements.txt requirements-lite.txt ./
RUN pip install --retries 10 --timeout 120 --index-url https://download.pytorch.org/whl/cpu torch \
 && pip install --retries 10 --timeout 120 -r requirements.txt

# Pre-download the sentence-transformers model so container start-up is fast.
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('paraphrase-multilingual-MiniLM-L12-v2')"

COPY . .
COPY --from=frontend /frontend/dist ./frontend/dist

# Build the seeded SQLite DB + FAISS index at image build time. No API key is needed:
# seeding uses the offline classifier; live complaints use Claude when ANTHROPIC_API_KEY is set.
RUN python -m app.seed && chown -R user:user /app

USER user
EXPOSE 7860
CMD ["bash", "start.sh"]
