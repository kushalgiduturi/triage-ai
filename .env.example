# Copy to .env and fill in. Never commit .env.

# LLM provider for extraction: claude (default) or ollama (open-source model running locally, free).
# Without a reachable provider the app uses the offline TF-IDF classifier and says so on every result.
PROVIDER=claude

# Claude (PROVIDER=claude)
ANTHROPIC_API_KEY=
# TRIAGE_CLAUDE_MODEL=claude-opus-5-5

# Ollama (PROVIDER=ollama). Install Ollama, then: ollama pull qwen2.5:3b
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_URL=http://localhost:11434
# OLLAMA_TIMEOUT=120                  # seconds per request
# OLLAMA_TEMPERATURE=0.1              # 0 to 0.2 keeps answers stable

# Optional overrides
# TRIAGE_DISABLE_LLM=1                # force the offline TF-IDF fallback
# TRIAGE_EMBEDDINGS=auto              # auto | sentence-transformers (Full) | onnx (Lite) | hash (tests/CI)
# TRIAGE_DB_PATH=data/triage.db
# PORT=7860                           # port used by start.sh / Docker
